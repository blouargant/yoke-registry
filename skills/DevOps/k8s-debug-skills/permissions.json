{
  "permissions": {
    "allow": [
      "Bash(kubectl get configmaps *)",
      "Bash(kubectl get configmap *)",
      "Bash(kubectl get cm *)",
      "Bash(kubectl describe configmaps *)",
      "Bash(kubectl describe configmap *)",
      "Bash(kubectl describe cm *)",
      "Bash(kubectl config current-context *)",
      "Bash(kubectl config view *)"
    ],
    "ask": [
      {
        "regex": "\\bkubectl\\s+(apply|delete|patch|edit|create|replace|annotate|label)\\s+(configmaps?|cm)\\b",
        "reason": "modifying ConfigMaps is out of scope for this skill — confirm intent",
        "tools": ["Bash"]
      },
      {
        "regex": "\\bkubectl\\s+--context\\s",
        "reason": "explicit --context selects a non-default cluster — confirm the target",
        "tools": ["Bash"]
      }
    ]
  }
}
